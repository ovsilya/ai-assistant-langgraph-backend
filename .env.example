# LLM provider: ai_gateway (internal LiteLLM proxy, default) | gemini
LLM_PROVIDER=ai_gateway

# Internal AI gateway (LiteLLM, OpenAI-compatible). Placeholders — set real values locally.
AI_GATEWAY_BASE_URL=https://ai-gateway.internal.example.com
AI_GATEWAY_API_KEY=your-api-key-here
AI_GATEWAY_MODEL_FAST=claude-haiku-4-5
AI_GATEWAY_MODEL_MAIN=claude-sonnet-4-6

# Gemini fallback provider (optional)
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_CLOUD_PROJECT=my-gcp-project

SITE_ID_DEFAULT=brand_alpha_us
MAX_ARTICLES=5
CHAT_CONTEXT_MESSAGES=6

# Content-search service — get_related (search API) + query_index (semantic search)
CONCORDE_BASE_URL=https://search.example.com
CONCORDE_AI_SEARCH_BASE_URL=https://content-search.internal.example.com
CONCORDE_SITE_ID=00000000-0000-0000-0000-000000000001
# Integration tests only — CMS content UUID for a sample article
CONCORDE_TEST_CONTENT_ID=00000000-0000-0000-0000-000000000002
CONCORDE_MAX_AGE=90d
CONCORDE_TIMEOUT=30

# App / infra (see config/base.py for all options)
ENVIRONMENT=dev
APP_NAME=ai-assistant
